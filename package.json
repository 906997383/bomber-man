{
  "name": "bomber-man-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Bomber Man clone (Android + iOS, Capacitor)",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "sync": "npx cap sync",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:ios": "bash build_ios.sh",
    "build:ios:sim": "bash build_ios.sh --simulator",
    "build:ios:ipa": "bash build_ios.sh --ipa"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
